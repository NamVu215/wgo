---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { SITE_URL, type City } from '../config.ts';

interface Props {
  title: string;
  description?: string;
  nav?: 'goi-y' | 'kham-pha' | 'ban-do' | 'da-luu';
  image?: string | false;
  // The city this page belongs to. Nav links stay inside it, and it becomes the visitor's current city.
  city?: City;
}

const { title, description = 'WGo – đi đâu, ăn gì. Quán local, giờ mở cửa, bản đồ, chỉ đường.', nav, image, city } = Astro.props;
// Without a city (Đã lưu, 404), links go to /, /kham-pha/, /ban-do/, which open the visitor's last city.
const base = city ? `/${city.id}/` : '/';
const ogImage = new URL(image || '/icon-512.png', SITE_URL).toString();
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const tabs = [
  { id: 'goi-y', href: base, label: 'Gợi ý', icon: 'sparkle' },
  { id: 'kham-pha', href: `${base}kham-pha/`, label: 'Khám phá', icon: 'search' },
  { id: 'ban-do', href: `${base}ban-do/`, label: 'Bản đồ', icon: 'map' },
  { id: 'da-luu', href: '/da-luu/', label: 'Đã lưu', icon: 'heart' },
] as const;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="WGo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#F6F0E4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15120E" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="WGo" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <Font cssVariable="--font-bricolage" preload={[{ subset: 'vietnamese', weight: 800, style: 'normal' }]} />
    <Font cssVariable="--font-be-vietnam" preload={[{ subset: 'vietnamese', weight: 400, style: 'normal' }]} />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body data-city={city?.id}>
    <slot />
    {nav && (
      <nav class="nav" aria-label="Điều hướng chính">
        {tabs.map((tab) => (
          <a href={tab.href} aria-current={tab.id === nav ? 'page' : undefined}>
            <span><Icon name={tab.icon} size={18} />{tab.label}</span>
          </a>
        ))}
      </nav>
    )}
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/pwa.ts';
    </script>
  </body>
</html>
