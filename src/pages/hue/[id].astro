---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { loadSiteData } from '../../lib/load.ts';
import type { Place } from '../../lib/data.ts';
import { daysOffText, hoursShort, hoursText } from '../../lib/hours.ts';
import { formatDateVi, formatPrice } from '../../lib/text.ts';
import { directionsUrl, formatDistance, jsonForScript, nearbyPlaces, placeSubtitle, placeUrl, toClientPlace } from '../../lib/view.ts';
import { photoUrl } from '../../lib/photos.ts';
import { averageText, formLink, summarize } from '../../lib/reviews.ts';
import { CITY, COMMUNITY } from '../../config.ts';

export async function getStaticPaths() {
  const data = await loadSiteData();
  return data.places.map((place) => ({ params: { id: place.id }, props: { place } }));
}

interface Props {
  place: Place;
}

const { place } = Astro.props;
const VERIFY_LABEL = { roi: 'WGo đã đi thử', online: 'Đã đối chiếu online', chua: 'Chưa kiểm chứng' };
const data = await loadSiteData();
const kind = data.kinds.find((k) => k.id === place.loai)?.ten ?? '';
const tags = place.tags.map((t) => data.tags.find((x) => x.id === t)?.ten ?? t);
const price = formatPrice(place.giaTu, place.giaDen);
const dishes = placeSubtitle(place, data.dishes, data.kinds, 4);
const sub = [kind, place.mon.length ? dishes : '', place.khuVuc].filter(Boolean).join(' · ');
const offText = daysOffText(place.hours);
const rating = place.wgoCham === null ? null : String(place.wgoCham).replace('.', ',');
const community = summarize(data.reviews, place.id);
const showScore = community.average !== null && community.count >= COMMUNITY.minReviews;
const reviewLink = formLink(COMMUNITY.danhGiaForm, place);
const reportLink = formLink(COMMUNITY.gopYForm, place);
const nearby = nearbyPlaces(place, data.places);
const description = [
  place.monNenGoi && `Nên gọi: ${place.monNenGoi}.`,
  place.hours.ranges.length ? `Giờ: ${hoursText(place.hours)}.` : '',
  price && `Giá: ${price}.`,
  place.diaChi,
].filter(Boolean).join(' ');
---
<Base title={`${place.ten} · ${CITY.name} · WGo`} description={description} image={place.anh[0] && photoUrl(place.anh[0], 'lon')}>
  <main class="page page--bare">
    <header class="topbar">
      <a class="icon-btn" href="/" id="back" aria-label="Quay lại"><Icon name="back" stroke={2.2} /></a>
      <div style="display:flex;gap:10px">
        <button class="icon-btn" type="button" id="share" aria-label="Chia sẻ"><Icon name="share" /></button>
        <button class="icon-btn" type="button" id="save" data-save={place.id} aria-pressed="false" aria-label="Lưu"><Icon name="heart" /></button>
      </div>
    </header>

    <div class="photo detail-photo">
      {place.anh.length > 0 && (
        <div class="gallery" tabindex="0" role="group" aria-label={`Ảnh ${place.ten}`}>
          {place.anh.map((id, i) => (
            <img
              src={photoUrl(id, 'lon')}
              alt={place.anh.length > 1 ? `Ảnh ${place.ten} (${i + 1}/${place.anh.length})` : `Ảnh ${place.ten}`}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ))}
        </div>
      )}
      {place.anh.length > 1 && <span class="gallery-count">{place.anh.length} ảnh · vuốt để xem</span>}
      {place.kiemChung !== 'roi' && <span class="sticker sticker--plain">{VERIFY_LABEL[place.kiemChung]}</span>}
    </div>

    <h1 class="display detail-name">{place.ten}</h1>
    {sub && <div class="detail-sub">{sub}</div>}

    <div class="tiles">
      <div class="tile">
        <span class="tile__label">Giờ bán</span>
        <span class="tile__value">{hoursShort(place.hours)}</span>
        <span class="tile__note" data-status={place.id}></span>
      </div>
      <div class="tile">
        <span class="tile__label">Giá</span>
        <span class="tile__value">{price || '—'}</span>
        <span class="tile__note muted">{place.loai === 'check-in' ? 'vé người lớn' : 'mỗi người'}</span>
      </div>
      <div class="tile tile--accent">
        <span class="tile__label">WGo chấm</span>
        <span class="tile__value">{rating ? `${rating}★` : '—'}</span>
        <span class="tile__note">{rating ? '' : 'chưa chấm'}</span>
      </div>
    </div>

    {place.monNenGoi && (
      <div class="detail-block">
        <h2 class="label-caps" style="margin:0">Nên gọi</h2>
        <p class="detail-lead">{place.monNenGoi}</p>
      </div>
    )}
    {place.nhanXet && (
      <div class="detail-block">
        <h2 class="label-caps" style="margin:0">WGo nhận xét</h2>
        <p>{place.nhanXet}</p>
      </div>
    )}
    {place.meo && (
      <div class="detail-block">
        <h2 class="label-caps" style="margin:0">Mẹo</h2>
        <p>{place.meo}</p>
      </div>
    )}
    {tags.length > 0 && (
      <div class="chip-wrap" style="margin-top:14px">
        {tags.map((t) => <span class="chip chip--small">{t}</span>)}
      </div>
    )}

    {(community.count > 0 || reviewLink) && (
      <section class="community" aria-labelledby="community-title">
        <div class="community__head">
          <h2 class="label-caps" id="community-title" style="margin:0">Cộng đồng</h2>
          {showScore ? (
            <span class="community__score"><Icon name="star" size={16} stroke={2.2} /> {averageText(community.average!)} · {community.count} lượt</span>
          ) : community.count > 0 ? (
            <span class="muted community__note">Cần {COMMUNITY.minReviews - community.count} đánh giá nữa để hiện điểm</span>
          ) : (
            <span class="muted community__note">Chưa có đánh giá</span>
          )}
        </div>
        {community.latest.length > 0 && (
          <ul class="reviews">
            {community.latest.map((r) => (
              <li class="review">
                <div class="review__meta">
                  <strong>{r.ten || 'Ẩn danh'}</strong>
                  <span class="review__stars" aria-label={`${r.sao} sao`}>{'★'.repeat(r.sao)}<span aria-hidden="true">{'★'.repeat(5 - r.sao)}</span></span>
                  {r.ngay && <span class="muted">{formatDateVi(r.ngay)}</span>}
                </div>
                <p>{r.nhanXet}</p>
              </li>
            ))}
          </ul>
        )}
        {reviewLink && (
          <a class="btn community__btn" href={reviewLink} target="_blank" rel="noopener">
            <Icon name="star" size={18} /> Đánh giá quán này
          </a>
        )}
        <p class="muted community__fine">Đánh giá của người dùng, WGo duyệt trước khi hiện. Tách riêng với điểm WGo chấm.</p>
      </section>
    )}

    <div class="info-rows">
      <div class="info-row">
        <Icon name="clock" />
        <div>
          {hoursText(place.hours)}
          {offText && <small>Nghỉ: {offText}</small>}
          {place.hours.lunarOff.length > 0 && <small id="lunar-next" hidden></small>}
        </div>
      </div>
      <div class="info-row">
        <Icon name="pin" />
        <div>{place.diaChi}<small id="distance" hidden></small></div>
        <button class="link-btn" type="button" id="copy-address" data-address={place.diaChi}>Sao chép</button>
      </div>
      <a class="info-row" href={`/ban-do/?id=${place.id}`}>
        <Icon name="map" />
        <div>Xem trên bản đồ WGo</div>
        <span class="link-btn">Mở</span>
      </a>
      {place.dienThoai && (
        <a class="info-row" href={`tel:${place.dienThoai}`}>
          <Icon name="phone" />
          <div>{place.dienThoai}</div>
          <span class="link-btn">Gọi</span>
        </a>
      )}
      {place.facebook && (
        <a class="info-row" href={place.facebook} target="_blank" rel="noopener nofollow">
          <Icon name="link" />
          <div>Facebook</div>
          <span class="link-btn">Mở</span>
        </a>
      )}
      {place.tiktok && (
        <a class="info-row" href={place.tiktok} target="_blank" rel="noopener nofollow">
          <Icon name="link" />
          <div>TikTok</div>
          <span class="link-btn">Mở</span>
        </a>
      )}
      {place.linkGoogleMaps && (
        <a class="info-row" href={place.linkGoogleMaps} target="_blank" rel="noopener nofollow">
          <Icon name="link" />
          <div>Xem trên Google Maps</div>
          <span class="link-btn">Mở</span>
        </a>
      )}
    </div>

    {reportLink && (
      <a class="report-link" href={reportLink} target="_blank" rel="noopener">
        <Icon name="flag" size={16} /> Thông tin sai hoặc quán đã đóng? Báo cho WGo
      </a>
    )}

    {nearby.length > 0 && (
      <section class="nearby" aria-labelledby="nearby-title">
        <h2 class="label-caps" id="nearby-title" style="margin:0">Gần đây có gì?</h2>
        <ul class="nearby__list">
          {nearby.map(({ place: p, km }) => (
            <li>
              <a class="nearby__item" href={placeUrl(p.id)}>
                <span class="nearby__name">{p.ten}</span>
                <span class="muted">{data.kinds.find((k) => k.id === p.loai)?.ten} · {formatDistance(km)}</span>
                <span data-status={p.id} class="tone-unknown"></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="source">
      {VERIFY_LABEL[place.kiemChung]}
      {place.nguon && ` · Nguồn: ${place.nguon}`}
      {place.capNhat && ` · Cập nhật ${formatDateVi(place.capNhat)}`}
    </p>
  </main>

  <div class="action-bar">
    <a class="btn btn--ink" href={directionsUrl(place)} target="_blank" rel="noopener">
      <Icon name="navigate" /> Chỉ đường bằng Google Maps
    </a>
  </div>

  <script type="application/json" id="wgo-place" set:html={jsonForScript(toClientPlace(place))} />
  <script type="application/json" id="wgo-nearby" set:html={jsonForScript(nearby.map(({ place: p }) => toClientPlace(p)))} />
  <script>
    import '../../scripts/place.ts';
  </script>
</Base>
