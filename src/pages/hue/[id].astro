---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { loadSiteData } from '../../lib/load.ts';
import type { Place } from '../../lib/data.ts';
import { daysOffText, hoursShort, hoursText } from '../../lib/hours.ts';
import { formatDateVi, formatPrice } from '../../lib/text.ts';
import { directionsUrl, jsonForScript, photoUrl, placeSubtitle, toClientPlace } from '../../lib/view.ts';
import { CITY } from '../../config.ts';

export async function getStaticPaths() {
  const data = await loadSiteData();
  return data.places.map((place) => ({ params: { id: place.id }, props: { place } }));
}

interface Props {
  place: Place;
}

const { place } = Astro.props;
const data = await loadSiteData();
const kind = data.kinds.find((k) => k.id === place.loai)?.ten ?? '';
const tags = place.tags.map((t) => data.tags.find((x) => x.id === t)?.ten ?? t);
const price = formatPrice(place.giaTu, place.giaDen);
const dishes = placeSubtitle(place, data.dishes, data.kinds, 4);
const sub = [kind, place.mon.length ? dishes : '', place.khuVuc].filter(Boolean).join(' · ');
const offText = daysOffText(place.hours);
const rating = place.wgoCham === null ? null : String(place.wgoCham).replace('.', ',');
const description = [
  place.monNenGoi && `Nên gọi: ${place.monNenGoi}.`,
  place.hours.ranges.length ? `Giờ: ${hoursText(place.hours)}.` : '',
  price && `Giá: ${price}.`,
  place.diaChi,
].filter(Boolean).join(' ');
---
<Base title={`${place.ten} · ${CITY.name} · WGo`} description={description}>
  <main class="page page--bare">
    <header class="topbar">
      <a class="icon-btn" href="/" id="back" aria-label="Quay lại"><Icon name="back" stroke={2.2} /></a>
      <div style="display:flex;gap:10px">
        <button class="icon-btn" type="button" id="share" aria-label="Chia sẻ"><Icon name="share" /></button>
        <button class="icon-btn" type="button" id="save" data-save={place.id} aria-pressed="false" aria-label="Lưu"><Icon name="heart" /></button>
      </div>
    </header>

    <div class="photo detail-photo">
      {place.anh[0] && <img src={photoUrl(place.anh[0])} alt={`Ảnh ${place.ten}`} />}
      {!place.kiemChung && <span class="sticker sticker--plain">Chưa kiểm chứng</span>}
    </div>

    <h1 class="display detail-name">{place.ten}</h1>
    {sub && <div class="detail-sub">{sub}</div>}

    <div class="tiles">
      <div class="tile">
        <span class="tile__label">Giờ bán</span>
        <span class="tile__value">{hoursShort(place.hours)}</span>
        <span class="tile__note" data-status={place.id}></span>
      </div>
      <div class="tile">
        <span class="tile__label">Giá</span>
        <span class="tile__value">{price || '—'}</span>
        <span class="tile__note muted">{place.loai === 'check-in' ? 'vé người lớn' : 'mỗi người'}</span>
      </div>
      <div class="tile tile--accent">
        <span class="tile__label">WGo chấm</span>
        <span class="tile__value">{rating ? `${rating}★` : '—'}</span>
        <span class="tile__note">{rating ? '' : 'chưa chấm'}</span>
      </div>
    </div>

    {place.monNenGoi && (
      <div class="detail-block">
        <h2 class="label-caps" style="margin:0">Nên gọi</h2>
        <p class="detail-lead">{place.monNenGoi}</p>
      </div>
    )}
    {place.nhanXet && (
      <div class="detail-block">
        <h2 class="label-caps" style="margin:0">WGo nhận xét</h2>
        <p>{place.nhanXet}</p>
      </div>
    )}
    {place.meo && (
      <div class="detail-block">
        <h2 class="label-caps" style="margin:0">Mẹo</h2>
        <p>{place.meo}</p>
      </div>
    )}
    {tags.length > 0 && (
      <div class="chip-wrap" style="margin-top:14px">
        {tags.map((t) => <span class="chip chip--small">{t}</span>)}
      </div>
    )}

    <div class="info-rows">
      <div class="info-row">
        <Icon name="clock" />
        <div>
          {hoursText(place.hours)}
          {offText && <small>Nghỉ: {offText}</small>}
          {place.hours.lunarOff.length > 0 && <small>WGo chưa tự tính ngày âm lịch, nên kiểm tra trước khi đi.</small>}
        </div>
      </div>
      <div class="info-row">
        <Icon name="pin" />
        <div>{place.diaChi}</div>
        <button class="link-btn" type="button" id="copy-address" data-address={place.diaChi}>Sao chép</button>
      </div>
      {place.dienThoai && (
        <a class="info-row" href={`tel:${place.dienThoai}`}>
          <Icon name="phone" />
          <div>{place.dienThoai}</div>
          <span class="link-btn">Gọi</span>
        </a>
      )}
      {place.facebook && (
        <a class="info-row" href={place.facebook} target="_blank" rel="noopener nofollow">
          <Icon name="link" />
          <div>Facebook</div>
          <span class="link-btn">Mở</span>
        </a>
      )}
      {place.tiktok && (
        <a class="info-row" href={place.tiktok} target="_blank" rel="noopener nofollow">
          <Icon name="link" />
          <div>TikTok</div>
          <span class="link-btn">Mở</span>
        </a>
      )}
      {place.linkGoogleMaps && (
        <a class="info-row" href={place.linkGoogleMaps} target="_blank" rel="noopener nofollow">
          <Icon name="link" />
          <div>Xem trên Google Maps</div>
          <span class="link-btn">Mở</span>
        </a>
      )}
    </div>

    <p class="source">
      {place.kiemChung ? 'WGo đã đi thử' : 'Chưa kiểm chứng'}
      {place.nguon && ` · Nguồn: ${place.nguon}`}
      {place.capNhat && ` · Cập nhật ${formatDateVi(place.capNhat)}`}
    </p>
  </main>

  <div class="action-bar">
    <a class="btn btn--ink" href={directionsUrl(place)} target="_blank" rel="noopener">
      <Icon name="navigate" /> Chỉ đường bằng Google Maps
    </a>
  </div>

  <script type="application/json" id="wgo-place" set:html={jsonForScript(toClientPlace(place))} />
  <script>
    import '../../scripts/place.ts';
  </script>
</Base>
