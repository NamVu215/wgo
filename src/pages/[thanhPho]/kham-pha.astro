---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import { loadSiteData } from '../../lib/load.ts';
import { COMMUNITY } from '../../config.ts';
import { citiesWithPlaces, type City } from '../../lib/cities.ts';
import { formLink } from '../../lib/reviews.ts';
import { BUOI } from '../../lib/hours.ts';
import { jsonForScript, PRICE_BUCKETS, toClientPlace } from '../../lib/view.ts';

export async function getStaticPaths() {
  const data = await loadSiteData();
  return citiesWithPlaces(data.places).map((city) => ({ params: { thanhPho: city.id }, props: { city } }));
}

const { city } = Astro.props as { city: City };
const all = await loadSiteData();
const data = { ...all, places: all.places.filter((p) => p.thanhPho === city.id) };
const manyCities = citiesWithPlaces(all.places).length > 1;
const dishes = data.dishes.map(({ id, ten }) => ({ id, ten }));
const kinds = data.kinds.map(({ id, ten }) => ({ id, ten }));
const client = { places: data.places.map(toClientPlace), dishes, kinds };
const usedDishes = dishes.filter((d) => data.places.some((p) => p.mon.includes(d.id)));
const usedKinds = kinds.filter((k) => data.places.some((p) => p.loai === k.id));
const suggestLink = formLink(COMMUNITY.gopYForm);
const sorted = [...data.places].sort((a, b) => (b.wgoCham ?? 0) - (a.wgoCham ?? 0));
---
<Base title={`Khám phá ${city.name} · WGo`} description={`Tìm quán ăn, quán nước, cafe, chỗ check-in ở ${city.name} theo món, giờ mở cửa và giá.`} nav="kham-pha" city={city}>
  <main class="page">
    <header class="topbar">
      <h1 class="display page-title">Khám phá</h1>
      {manyCities ? (
        <a class="pill" href="/?chon=1" aria-label={`Đang xem ${city.name}. Đổi thành phố`}>{city.name} <Icon name="chevron" size={14} stroke={2.4} /></a>
      ) : (
        <span class="pill">{city.name}</span>
      )}
    </header>

    <form class="search" role="search" id="search-form">
      <Icon name="search" />
      <label class="visually-hidden" for="q">Tìm món, tên quán</label>
      <input id="q" name="q" type="search" placeholder="Tìm món, tên quán…" autocomplete="off" enterkeyhint="search" />
    </form>

    <div class="chip-row" style="margin-top:12px" id="quick-row">
      <button class="icon-btn filter-btn" type="button" id="open-filters" aria-label="Mở bộ lọc">
        <Icon name="sliders" />
        <span class="badge" id="filter-count" hidden></span>
      </button>
      <button class="chip" type="button" id="toggle-open" aria-pressed="false">
        <Icon name="check" size={16} stroke={2.4} /> Đang mở
      </button>
      <span id="active-chips" style="display:contents"></span>
    </div>

    <div class="results-head">
      <strong id="result-count">{data.places.length} chỗ</strong>
      <label class="sort">
        <span class="visually-hidden">Sắp xếp</span>
        <select id="sort">
          <option value="cham">WGo chấm cao nhất</option>
          <option value="gan">Gần tôi nhất</option>
          <option value="gia">Giá thấp nhất</option>
          <option value="ten">Tên A–Z</option>
        </select>
        <Icon name="chevron" size={14} stroke={2.4} />
      </label>
    </div>

    <ul class="cards" id="cards">
      {sorted.map((place) => <PlaceCard place={place} dishes={dishes} kinds={kinds} />)}
    </ul>

    <div class="empty" id="empty" hidden>
      <div class="empty__title">Không có chỗ nào khớp.</div>
      <p class="muted" id="empty-hint" style="margin:0">Thử bỏ bớt bộ lọc.</p>
      <button class="btn" type="button" id="empty-reset">Bỏ hết bộ lọc</button>
    </div>

    {suggestLink && (
      <a class="suggest" href={suggestLink} target="_blank" rel="noopener">
        <Icon name="plus" size={20} stroke={2.4} />
        <span><strong>Biết quán ngon chưa có ở đây?</strong><br /><span class="muted">Gợi ý cho WGo, mình sẽ ghé kiểm tra.</span></span>
      </a>
    )}
  </main>

  <dialog class="sheet" id="filters" aria-labelledby="filters-title">
    <div class="sheet__inner">
      <div class="sheet__handle"></div>
      <div class="sheet__head">
        <h2 class="display" id="filters-title">Bộ lọc</h2>
        <button type="button" id="clear-filters">Xóa hết</button>
      </div>

      <section>
        <h3 class="label-caps" style="margin:0">Giờ</h3>
        <div class="chip-wrap">
          <button class="chip" type="button" data-filter="mo" data-value="1" aria-pressed="false">Đang mở</button>
          {Object.entries(BUOI).map(([id, b]) => (
            <button class="chip" type="button" data-filter="buoi" data-value={id} aria-pressed="false">{b.label}</button>
          ))}
        </div>
      </section>

      <section>
        <h3 class="label-caps" style="margin:0">Loại</h3>
        <div class="grid-2">
          {usedKinds.map((k) => (
            <button class="chip chip--tile" type="button" data-filter="loai" data-value={k.id} aria-pressed="false">{k.ten}</button>
          ))}
        </div>
      </section>

      <section>
        <h3 class="label-caps" style="margin:0">Món</h3>
        <div class="chip-wrap">
          {usedDishes.map((d) => (
            <button class="chip" type="button" data-filter="mon" data-value={d.id} aria-pressed="false">{d.ten}</button>
          ))}
        </div>
      </section>

      <section>
        <h3 class="label-caps" style="margin:0">Giá mỗi người</h3>
        <div class="grid-4">
          {PRICE_BUCKETS.map((b) => (
            <button class="chip" type="button" data-filter="gia" data-value={b.id} aria-pressed="false">{b.label}</button>
          ))}
        </div>
      </section>

      <div class="sheet__footer">
        <button class="btn btn--ink" type="button" id="apply-filters">Xem kết quả</button>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="wgo-data" set:html={jsonForScript(client)} />
  <script>
    import '../../scripts/explore.ts';
  </script>
</Base>
